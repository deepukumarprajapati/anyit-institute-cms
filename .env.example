# API
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/anyit_cms
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# * = allow any Origin (LAN-friendly). Or list: http://localhost:5173,http://192.168.1.10:5173
CORS_ORIGIN=*
UPLOAD_DIR=uploads

# Bootstrap (used by seed)
BOOTSTRAP_ADMIN_EMAIL=admin@anyit.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
BOOTSTRAP_INSTITUTE_NAME=AnyIT Institute
